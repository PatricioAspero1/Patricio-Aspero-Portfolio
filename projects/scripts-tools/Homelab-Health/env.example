# Example configuration for the public/sanitized scripts.
# Copy to a private environment file and fill in your own values.
# Do NOT commit real secrets to GitHub.

SSH_USER=admin

# Proxmox / infrastructure hosts
CLUSTER_QUERY_HOST=proxmox-node-1.internal
CONTAINER_HOST=proxmox-node-2.internal
HERMES_HOST=tunnel-host.internal
MEDIA_HOST=media-node.internal
ATLAS_HOST=storage.internal
ATLAS_SSH_USER=admin

# Monitoring URLs
PROMETHEUS_URL=http://monitoring.internal:9090
GRAFANA_URL=http://monitoring.internal:3000

# Application URLs and API keys
SONARR_URL=http://sonarr.internal:8989
RADARR_URL=http://radarr.internal:7878
SONARR_API_KEY=replace_me
RADARR_API_KEY=replace_me

# Update hosts: NAME=HOST pairs separated by spaces
UPDATE_HOSTS="Node1=node1.internal Node2=node2.internal"

# Limited recovery list
CRITICAL_CTS="104 105 106"

# Storage
MEDIA_PATH=/mnt/media

# Ollama / briefing
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# Discord
DISCORD_WEBHOOK=replace_me

# Optional weather data
WEATHER_CITIES="City One,City Two"
WEATHER_LATS="00.0000,00.0000"
WEATHER_LONS="00.0000,00.0000"
